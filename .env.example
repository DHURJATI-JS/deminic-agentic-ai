# ---------------------------------------------------------------------------
# Deminic Agentic AI configuration. The installers generate .env from this
# file and fill every value marked __GENERATE__ with a fresh random secret.
# ---------------------------------------------------------------------------

# Web server
# 0.0.0.0 = reachable from every device on your LAN
APP_HOST=0.0.0.0
APP_PORT=8700
# HTTPS listener for LAN devices (browsers only allow microphone/geolocation on HTTPS or localhost)
ENABLE_LAN_HTTPS=true
HTTPS_PORT=8743
APP_BASE_URL=http://127.0.0.1:8700
# Set to true only when serving over HTTPS (marks cookies Secure)
COOKIE_SECURE=false

# Secrets (never commit real values)
SECRET_KEY=__GENERATE__
ENCRYPTION_KEY=__GENERATE__
DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__

# Infrastructure (docker-compose publishes these on localhost only)
DB_PORT=5445
REDIS_PORT=6385
CLAMAV_PORT=3311
OLLAMA_PORT=11435
DATABASE_URL=postgresql+asyncpg://deminic:${DB_PASSWORD}@127.0.0.1:5445/deminic
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6385/0
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3311

# Default local AI gateway (pre-filled on the sign-up form; every user can override it)
DEFAULT_GATEWAY_URL=http://localhost:8000/v1
DEFAULT_GATEWAY_KEY=
DEFAULT_LOCAL_MODEL=gemma
DEFAULT_CODER_MODEL=qwen

# Local fallback models served by the dockerised Ollama
OLLAMA_URL=http://127.0.0.1:11435/v1
FALLBACK_CHAT_MODEL=gemma3:4b
FALLBACK_CODER_MODEL=qwen2.5-coder:3b
# Embedding model for pgvector semantic search (384-d, served by the dockerised Ollama)
EMBED_MODEL=all-minilm

# Optional system SMTP used for password-reset mail when a user has no SMTP of their own
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_SMTP_FROM=

# Rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_LOGIN=120/minute
RATE_LIMIT_CHAT=60/minute
